/* src/App.css */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');

:root {
  --primary: #2563eb;
  --primary-hover: #1d4ed8;
  --bg: #f8fafc;
  --white: #ffffff;
  --text-main: #0f172a;
  --text-muted: #64748b;
  --border: #e2e8f0;
  --container-width: 1200px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Inter', sans-serif;
  background-color: var(--bg);
  color: var(--text-main);
  line-height: 1.5;
}

/* --- NAVBAR: The Centerpiece --- */
.navbar {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 1000;
  height: 80px;
  display: flex;
  align-items: center;
}

.nav-content {
  width: 100%;
  max-width: var(--container-width);
  margin: 0 auto;
  padding: 0 40px; /* Essential left/right padding */
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--primary);
  letter-spacing: -1px;
  cursor: pointer;
}

.nav-search {
  flex: 0 1 400px;
  padding: 12px 20px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: #f1f5f9;
  outline: none;
  transition: 0.2s;
}

.nav-search:focus {
  background: white;
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
}

/* --- BUTTONS: No more ugly boxes --- */
.auth-group { display: flex; gap: 12px; align-items: center; }
/* --- AUTH PAGE STYLES --- */
.auth-page {
  display: flex;
  justify-content: center; /* Centers horizontally */
  align-items: center;     /* Centers vertically */
  min-height: calc(100vh - 80px); /* Fill the screen below navbar */
  padding: 40px 20px;
}

.auth-card {
  background: white;
  width: 100%;
  max-width: 450px; /* Limits how wide the form gets */
  padding: 40px;
  border-radius: 24px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  border: 1px solid var(--border);
  text-align: left;
}

.auth-badge {
  display: inline-block;
  background: #eff6ff;
  color: var(--primary);
  padding: 6px 12px;
  border-radius: 99px;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.auth-subtitle {
  color: var(--text-muted);
  margin-bottom: 30px;
  font-size: 15px;
}

.auth-switch {
  margin-top: 24px;
  text-align: center;
  font-size: 14px;
  color: var(--text-muted);
}

.auth-switch span {
  color: var(--primary);
  font-weight: 700;
  cursor: pointer;
}

.auth-switch span:hover {
  text-decoration: underline;
}

/* Fixes for the form group inside the card */
.auth-card .form-group {
  margin-bottom: 20px;
}

.auth-card .form-group label {
  display: block;
  font-weight: 600;
  margin-bottom: 8px;
  font-size: 14px;
}

.auth-card .form-group input {
  width: 100%;
  padding: 12px 16px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: #f8fafc;
}
.login-btn {
  background: transparent;
  border: none;
  font-weight: 600;
  color: var(--text-muted);
  cursor: pointer;
  padding: 10px 15px;
}

.signup-btn {
  background: var(--primary);
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 10px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s;
}

.signup-btn:hover { background: var(--primary-hover); }

/* --- MAIN LAYOUT --- */
.container {
  max-width: var(--container-width);
  margin: 40px auto;
  padding: 0 40px; /* Matches navbar for perfect alignment */
  display: flex;
  gap: 40px;
}

.sidebar { width: 260px; flex-shrink: 0; }

.feed { flex: 1; }

.feed-title {
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 30px;
  letter-spacing: -0.5px;
}

/* --- CARDS --- */
.job-card {
  background: var(--white);
  padding: 30px;
  border-radius: 20px;
  margin-bottom: 20px;
  border: 1px solid var(--border);
  box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
  transition: 0.3s;
  cursor: pointer;
}

.job-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);
  border-color: var(--primary);
}

/* --- SIDEBAR & CATEGORY BUTTONS --- */
.sidebar-title {
  font-size: 0.75rem;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 1.5rem;
  font-weight: 700;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* This replaces the grey boxes with clean, rounded buttons */
.category-btn {
  display: block;
  width: 100%;
  padding: 12px 16px;
  background: transparent; /* Removes the grey background */
  border: 1px solid transparent; /* Removes the default border */
  border-radius: 12px;
  text-align: left;
  font-weight: 600;
  color: #64748b;
  cursor: pointer;
  transition: all 0.2s ease;
}

.category-btn:hover {
  background: #f1f5f9;
  color: #2563eb;
}

/* Blue style for the currently selected category */
.category-btn.active {
  background: #eff6ff;
  color: #2563eb;
  border-color: #bfdbfe;
}

/* --- LOGIN/LOGOUT NAV BUTTONS --- */
/* This ensures the top buttons don't look like grey boxes either */
.login-btn, .logout-btn {
  background: transparent;
  border: none;
  font-weight: 700;
  color: #1e293b;
  cursor: pointer;
  padding: 10px 15px;
}

.signup-btn {
  background: #2563eb;
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 10px;
  font-weight: 700;
  cursor: pointer;
}